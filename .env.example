# Copia este archivo como .env.local y ajusta la URL según el entorno (ver docs/API.md, sección 2).
# Navegador en la misma Mac:   http://localhost:8000/api/v1
# Emulador Android:            http://10.0.2.2:8000/api/v1
# Teléfono físico (misma red): http://<IP-de-la-Mac>:8000/api/v1  (backend con --host=0.0.0.0)
VITE_API_URL=http://localhost:8000/api/v1

# Pantallas de capitán y chofer con datos de prueba mientras el backend no tenga sus endpoints.
VITE_CREW_DEMO=true
